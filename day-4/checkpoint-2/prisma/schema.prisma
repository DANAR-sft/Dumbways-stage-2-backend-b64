generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id    Int     @id @default(autoincrement())
  name  String
  price Int
  stock Stock[]
}

model Supplier {
  id      Int     @id @default(autoincrement())
  name    String
  contact String?
  stocks  Stock[]
}

model Stock {
  id         Int @id @default(autoincrement())
  productId  Int
  supplierId Int
  quantity   Int

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
}
